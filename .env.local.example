# Local development environment — uses MinIO for S3 (no real AWS needed)
# Copy this to .env.local before running docker-compose.local.yml

SECRET_KEY=local-dev-secret-change-in-production

# MySQL is configured but not used by any model; SQLite keeps startup clean
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
SQLALCHEMY_DATABASE_URI=sqlite:///local.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

APP_TITLE=C4GT Website

# MinIO (local S3-compatible storage) — matches docker-compose.local.yml credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=c4gt-dev-bucket

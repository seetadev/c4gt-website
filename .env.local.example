# Local development environment for docker-compose.local.yml (MinIO provides S3; no real AWS needed)
# Copy this to .env.local before running: cp .env.local.example .env.local

# Flask session signing key. Replace for anything other than local use.
SECRET_KEY=local-dev-secret-change-in-production

# Set to true for the Flask debugger/reloader (never in production)
FLASK_DEBUG=false

# The app never queries a database; Flask-SQLAlchemy only needs a URI to initialise
SQLALCHEMY_DATABASE_URI=sqlite:///local.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

APP_TITLE=C4GT Website

# MinIO (local S3-compatible storage). These credentials also become the MinIO root user.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# Service name inside the compose network (the host-side port is MINIO_PORT, default 9100)
AWS_S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=c4gt-dev-bucket

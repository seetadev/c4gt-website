FLASK_DEBUG=false
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
SQLALCHEMY_DATABASE_URI=
SQLALCHEMY_TRACK_MODIFICATIONS=
APP_TITLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# S3-compatible endpoint override. Set it for MinIO/LocalStack (e.g. http://localhost:9000);
# leave blank to use real AWS S3.
AWS_S3_ENDPOINT=
S3_BUCKET_NAME=
